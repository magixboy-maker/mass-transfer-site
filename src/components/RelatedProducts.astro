---
import { PRODUCTS } from '../data/products';
interface Props { slugs: string[]; title?: string; }
const { slugs, title = 'Related Products' } = Astro.props;
const items = slugs.map((s) => PRODUCTS.find((p) => p.slug === s)).filter(Boolean);
---
{items.length > 0 && (
  <section style="margin-top:36px;">
    <h2>{title}</h2>
    <div class="grid">
      {items.map((p) => (
        <div class="card">
          <h3><a href={`/random-packing/${p!.slug}/`}>{p!.name}</a></h3>
          <p>{p!.metaDescription.slice(0, 110)}…</p>
        </div>
      ))}
    </div>
  </section>
)}
