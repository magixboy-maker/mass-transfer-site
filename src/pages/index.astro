---
import Layout from '../layouts/Layout.astro';
import { SITE, NAV } from '../data/site';
import { PRODUCTS } from '../data/products';
import { CATALOG } from '../data/catalog';
import { APPLICATIONS } from '../data/applications';

// 首页精选：每个品类挑一个，让访客在首屏下方就能看到瓷球、研磨球、分子筛
const ALL_PRODUCTS = [...PRODUCTS, ...CATALOG];
const FEATURED_SLUGS = [
  'pall-ring-ceramic',
  'corrugated-sheet',
  'wire-mesh-pad',
  'high-alumina-ball',
  'grinding-ball',
  'molecular-sieve-13x',
];
const FEATURED = FEATURED_SLUGS.map((s) => ALL_PRODUCTS.find((p) => p.slug === s)).filter(
  (p): p is NonNullable<typeof p> => Boolean(p)
);

// 首页文章入口：取最新 3 篇技术文章
const POSTS = (await Astro.glob('../content/blog/*.md'))
  .sort((a, b) => new Date(b.frontmatter.pubDate).getTime() - new Date(a.frontmatter.pubDate).getTime())
  .slice(0, 3)
  .map((p) => ({
    slug: p.file.split('/').pop()!.replace(/\.md$/, ''),
    title: p.frontmatter.title,
    description: p.frontmatter.description,
    pubDate: p.frontmatter.pubDate,
  }));

// 首页分类卡片：每个分类配一张代表图
const CATEGORY_CARDS = [
  {
    href: '/random-packing/',
    name: 'Random Packing',
    desc: 'Pall rings, Raschig rings, Cascade Mini Rings, saddles and Tri-Pack in metal, plastic and ceramic.',
    img: '/images/products/pall-ring-metal.webp',
  },
  {
    href: '/structured-packing/',
    name: 'Structured Packing',
    desc: 'Wire mesh and corrugated sheet packing for high-efficiency distillation, absorption and CO₂ capture.',
    img: '/images/products/plastic-structured.webp',
  },
  {
    href: '/mist-eliminator/',
    name: 'Mist Eliminators',
    desc: 'Wire mesh pads, vane and blade separators to remove entrained liquid droplets from gas streams.',
    img: '/images/products/vane-type.webp',
  },
  {
    href: '/tower-internals/',
    name: 'Tower Internals',
    desc: 'Liquid distributors, support plates and demisters matched to your column for reliable performance.',
    img: '/images/internals/support-plates.svg',
  },
  {
    href: '/ceramic-balls/',
    name: 'Ceramic Balls',
    desc: 'Inert alumina, high alumina, porous and refractory balls for catalyst bed support and flow distribution.',
    img: '/images/products/inert-alumina-ceramic-ball.webp',
  },
  {
    href: '/adsorbents/',
    name: 'Adsorbents & Desiccants',
    desc: 'Activated alumina and molecular sieve 3A, 4A, 5A and 13X for drying and gas purification.',
    img: '/images/products/molecular-sieve-3a.webp',
  },
  {
    href: '/filter-media/',
    name: 'Filter Media',
    desc: 'Ceramic sand and ceramsite media for potable water, wastewater and biofiltration.',
    img: '/images/products/ceramsite-filter-media.webp',
  },
  {
    href: '/honeycomb-ceramics/',
    name: 'Honeycomb Ceramics',
    desc: 'Ceramic honeycomb media for RTO heat exchange and cordierite wall-flow DPF substrates.',
    img: '/images/products/dpf-cordierite-honeycomb.webp',
  },
];
---

<Layout
  title="Mass Transfer Equipment Supplier | Tower Packing & Column Internals"
  description={SITE.description}
  canonical="https://www.mass-transfer.com/"
>
  <section class="hero">
    <div class="wrap">
      <h1>Mass Transfer Equipment, Factory-Direct</h1>
      <p>
        {SITE.tagline}
      </p>
      <p style="margin-top:14px;color:var(--text-muted);">
        ISO 9001-certified production partner. Random and structured packing, mist eliminators and tower internals for distillation, absorption, scrubbing and carbon capture — one margin layer, not two.
      </p>
      <div class="cta-row">
        <a class="btn" href="/contact/">Request a Quote</a>
        <a class="btn ghost" href="/applications/">Explore Applications</a>
      </div>
    </div>
  </section>

  <div class="wrap">
    <section style="margin-top:40px;">
      <h2>Packing Categories</h2>
      <div class="grid">
        {CATEGORY_CARDS.map((c) => (
          <div class="card">
            <a class="card-media" href={c.href} tabindex="-1" aria-hidden="true">
              <img src={c.img} alt={c.name} width="400" height="300" loading="lazy" decoding="async" />
            </a>
            <h3><a href={c.href}>{c.name}</a></h3>
            <p>{c.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <section style="margin-top:44px;">
      <h2>Featured Products</h2>
      <div class="grid">
        {FEATURED.map((p) => (
          <div class="card">
            {p.image && (
              <a class="card-media" href={`/${p.category}/${p.slug}/`} tabindex="-1" aria-hidden="true">
                <img src={p.image} alt={p.name} width="400" height="300" loading="lazy" decoding="async" />
              </a>
            )}
            <h3><a href={`/${p.category}/${p.slug}/`}>{p.name}</a></h3>
            <p>{p.metaDescription.slice(0, 110)}…</p>
          </div>
        ))}
      </div>
    </section>

    <section style="margin-top:44px;">
      <h2>Applications We Serve</h2>
      <div class="grid">
        {APPLICATIONS.slice(0, 8).map((a) => (
          <div class="card">
            <h3><a href={`/applications/${a.slug}/`}>{a.h1}</a></h3>
            <p>{a.metaDescription.slice(0, 110)}…</p>
          </div>
        ))}
      </div>
      <p style="margin-top:16px;"><a href="/applications/">View all applications →</a></p>
    </section>

    <section style="margin-top:44px;">
      <h2>Technical Guides</h2>
      <p class="page-sub" style="margin-bottom:20px;">
        How to choose between packing types, materials and internals — written for engineers, not for search engines.
      </p>
      <div class="grid">
        {POSTS.map((post) => (
          <div class="card">
            <h3><a href={`/blog/${post.slug}/`}>{post.title}</a></h3>
            <p>{post.description}</p>
            <p style="margin-top:8px;font-size:13px;color:var(--text-muted);">
              {new Date(post.pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </p>
          </div>
        ))}
      </div>
      <p style="margin-top:16px;"><a href="/blog/">All technical articles →</a></p>
    </section>

    <section style="margin-top:44px;">
      <h2>Why Buy Factory-Direct</h2>
      <div class="prose">
        <ul>
          <li><strong>One margin layer, not two</strong> — you deal directly with the export and supply entity, without a middleman adding cost.</li>
          <li><strong>ISO 9001-certified production</strong> — consistent quality with documented inspection and test reports.</li>
          <li><strong>Engineering support</strong> — we help select packing and internals for your specific duty, not just sell a part number.</li>
          <li><strong>Real evidence</strong> — inspection reports, packing and loading photos available on request.</li>
        </ul>
      </div>
    </section>
  </div>
</Layout>
