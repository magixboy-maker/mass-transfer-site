---
import Layout from '../../layouts/Layout.astro';
import Cta from '../../components/Cta.astro';

export async function getStaticPaths() {
  const posts = await Astro.glob('../../content/blog/*.md');
  return posts.map((post) => {
    const slug = post.file.split('/').pop()!.replace(/\.md$/, '');
    return { params: { slug }, props: { post } };
  });
}

const { post } = Astro.props;
const postUrl = `/blog/${post.file.split('/').pop()!.replace(/\.md$/, '')}/`;
const html = post.compiledContent();
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.frontmatter.title,
  description: post.frontmatter.description,
  datePublished: post.frontmatter.pubDate,
  author: { '@type': 'Organization', name: 'Pingxiang Xinquan Chemical Packing Co., Ltd.' },
};
---

<Layout
  title={post.frontmatter.title}
  description={post.frontmatter.description}
  canonical={`https://www.mass-transfer.com${postUrl}`}
  schema={schema}
  breadcrumb={[{ label: 'Blog', href: '/blog/' }, { label: post.frontmatter.title }]}
>
  <div class="wrap">
    <article class="prose" set:html={html} />
    <Cta heading="Need help choosing packing?" />
  </div>
</Layout>
