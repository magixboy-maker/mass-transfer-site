---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found | Mass Transfer Equipment"
  description="The page you were looking for could not be found."
  canonical="https://www.mass-transfer.com/404/"
>
  <div class="wrap" style="text-align:center;padding:60px 0;">
    <h1 style="font-size:48px;margin:0;">404</h1>
    <p style="color:var(--text-muted);margin:12px 0 28px;">The page you're looking for doesn't exist or has moved.</p>
    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
      <a class="btn" href="/">Back to Home</a>
      <a class="btn ghost" href="/random-packing/">Random Packing</a>
      <a class="btn ghost" href="/contact/">Contact Us</a>
    </div>
  </div>
</Layout>
